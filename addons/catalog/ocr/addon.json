{
  "schema": "flexrun.addon/v1",
  "name": "ocr",
  "label": "OCR",
  "description": "Optical character recognition service for capture pipelines.",
  "tier": "enterprise",
  "entitlement": "ocr",
  "kind": "container",
  "arches": ["x86"],
  "component": "ocr",
  "container": {
    "name": "ocr",
    "default_tag": "prod",
    "restart": "unless-stopped",
    "gpu": "optional",
    "ports": [{"host": 5002, "container": 5002}],
    "log_opts": {"max-size": "50m", "max-file": "5"}
  },
  "health": {
    "type": "http",
    "host": "172.17.0.1",
    "port": 5002,
    "path": "/",
    "timeout": 2
  },
  "ui": {
    "icon": "Translate",
    "order": 10,
    "manage": "toggle"
  },
  "legacy_routes": {
    "manage": "/manage_ocr",
    "status": "/ocr_status"
  }
}
