system_server/creds.txt

# Python bytecode - was tracked until now; stale .pyc can shadow a source file
__pycache__/
*.py[cod]

# macOS resource forks. Pre-existing ._* files stay tracked; this stops new ones.
._*

# Test and build output. These were tracked, so every test run - local or CI -
# produced a binary diff in the working tree.
.coverage
coverage.xml
htmlcov/
.pytest_cache/
npm-debug.log

# MQTT certificates - contain private keys
setup/mqtt/ssl/
setup/mqtt/ssl-dev/
setup/mqtt/ssl-prod/
setup/mqtt/gke/ssl-dev/
setup/mqtt/gke/ssl-prod/
setup/mqtt/gke/certs-dev/
setup/mqtt/gke/certs-prod/
setup/mqtt/vernemq.conf.orig
setup/mqtt/vernemq-local.conf

# Release notes
release_notes/

# guided release tool scratch (release/cut.py)
.release-work/

# Key material. The repo is public, and system_server/timemachine/server.key
# was committed in 2022 and is still in origin/master.
*.key
*.pem
*.crt
*.p12
*.pfx
cosign.key
!setup/mqtt/ssl/*.example

# scratch/working artifacts, not part of the system
*.dc.html
canvas.json
onprem-release-pipeline.html
